# Local development only. Change every value for any exposed environment.
MYSQL_ROOT_PASSWORD=local-root-password
MYSQL_PASSWORD=local-app-password
REDIS_PASSWORD=local-redis-password
RABBITMQ_USER=owlet
RABBITMQ_PASSWORD=local-rabbit-password
JWT_SECRET=replace-this-with-at-least-32-random-characters

# Ranking snapshots and bounded dependency calls.
HOT_WINDOW=24h
RANK_REFRESH=1m
FEED_SNAPSHOT_TTL=15m
FEED_RANK_LIMIT=2000
REDIS_TIMEOUT=200ms
DB_TIMEOUT=3s

# Opt-in loopback profiling: API 6060, Worker 6061.
PPROF_ENABLED=false
